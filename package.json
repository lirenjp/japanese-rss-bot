{
  "name": "japanese-rss-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "node --test test/*.test.js",
    "test:worker": "wrangler deploy --dry-run --outdir dist && node scripts/smoke-worker.js",
    "check": "node --check src/index.js && npm test && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply japanese-rss-bot --local",
    "db:remote": "wrangler d1 migrations apply japanese-rss-bot --remote",
    "telegram:setup": "node --env-file-if-exists=.dev.vars scripts/setup-telegram.js"
  },
  "dependencies": {
    "he": "1.2.0"
  },
  "devDependencies": {
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "4.149.0"
  }
}
